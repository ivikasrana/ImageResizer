<Window x:Class="ImageResizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Resizer" Width="680" Height="740" MinWidth="600" MinHeight="640"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource LabelBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- Header -->
            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Image Resizer" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="Batch resize photos to JPG or WebP" Style="{StaticResource Caption}" FontWeight="Normal" FontSize="13" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="BtnTheme" Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="BtnTheme_Click" ToolTip="Toggle light / dark"/>
            </Grid>

            <!-- Folders -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="SOURCE FOLDER" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSource" IsReadOnly="True"/>
                        <Button x:Name="BtnSource" Grid.Column="1" Content="Browse" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="BtnSource_Click"/>
                    </Grid>
                    <TextBlock Text="OUTPUT FOLDER" Style="{StaticResource Caption}" Margin="0,16,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtDest" IsReadOnly="True"/>
                        <Button x:Name="BtnDest" Grid.Column="1" Content="Browse" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="BtnDest_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Settings -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="FORMAT" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource FillBrush}" CornerRadius="10" Padding="2" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbJpg" Content="JPG" IsChecked="True" Style="{StaticResource SegmentRadio}"/>
                            <RadioButton x:Name="RbWebp" Content="WebP" Style="{StaticResource SegmentRadio}"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="Size" VerticalAlignment="Center"/>
                        <Slider x:Name="SldSize" Grid.Column="1" Minimum="1" Maximum="100" Value="100" IsSnapToTickEnabled="True" TickFrequency="1"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SldSize, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Text="Quality" VerticalAlignment="Center" Margin="0,8,0,0"/>
                        <Slider x:Name="SldQuality" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="100" Value="85" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=SldQuality, StringFormat={}{0:0}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <CheckBox x:Name="ChkSub" Content="Include sub-folders" IsChecked="True" Margin="0,0,28,0"/>
                        <CheckBox x:Name="ChkExif" Content="Keep EXIF" IsChecked="True"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button x:Name="BtnStart" Content="Process Images" Click="BtnStart_Click" Height="44" Padding="28,0" FontSize="15" FontWeight="SemiBold"/>
                <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource GhostButton}" Height="44" Margin="10,0,0,0" IsEnabled="False" Click="BtnCancel_Click"/>
            </StackPanel>

            <!-- Progress -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <ProgressBar x:Name="Progress" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="LblStatus" Text="Ready." Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
